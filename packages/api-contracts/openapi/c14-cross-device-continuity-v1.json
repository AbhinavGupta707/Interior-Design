{
  "openapi": "3.1.2",
  "info": {
    "title": "Interior Design Cross-Device Continuity API",
    "version": "c14-cross-device-continuity-v1"
  },
  "servers": [{ "url": "/" }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/v1/projects/{projectId}/design-option-jobs/{jobId}/options/{optionId}/confirmation": {
      "get": {
        "operationId": "getOptionConfirmation",
        "summary": "Recover the exact persisted C12 option confirmation",
        "parameters": [
          { "$ref": "#/components/parameters/ProjectId" },
          { "$ref": "#/components/parameters/JobId" },
          { "$ref": "#/components/parameters/OptionId" }
        ],
        "responses": {
          "200": {
            "description": "Exact persisted confirmation",
            "headers": { "Cache-Control": { "$ref": "#/components/headers/PrivateNoStore" } },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OptionConfirmation" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/v1/projects/{projectId}/render-eligible-sources": {
      "get": {
        "operationId": "listRenderEligibleSources",
        "summary": "Discover current exact C10/C13/camera render choices",
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "responses": {
          "200": {
            "description": "Current server-authoritative eligible-source snapshot",
            "headers": { "Cache-Control": { "$ref": "#/components/headers/PrivateNoStore" } },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RenderEligibleSourcesResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "opaque" }
    },
    "parameters": {
      "ProjectId": {
        "name": "projectId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "JobId": {
        "name": "jobId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "OptionId": {
        "name": "optionId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      }
    },
    "headers": {
      "PrivateNoStore": { "schema": { "type": "string", "const": "private, no-store" } }
    },
    "responses": {
      "Problem": {
        "description": "Problem response",
        "content": {
          "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,79}$" },
          "detail": { "type": "string", "maxLength": 500 },
          "status": { "type": "integer", "minimum": 400, "maximum": 599 },
          "title": { "type": "string", "maxLength": 160 }
        }
      },
      "OptionConfirmation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "branchId",
          "branchRevision",
          "commitId",
          "confirmedAt",
          "confirmedBy",
          "id",
          "idempotencyKey",
          "optionId",
          "previewId",
          "projectId",
          "resultSnapshotSha256",
          "schemaVersion"
        ],
        "properties": {
          "branchId": { "type": "string", "format": "uuid" },
          "branchRevision": { "type": "integer", "minimum": 1 },
          "commitId": { "type": "string", "format": "uuid" },
          "confirmedAt": { "type": "string", "format": "date-time" },
          "confirmedBy": { "type": "string", "format": "uuid" },
          "id": { "type": "string", "format": "uuid" },
          "idempotencyKey": { "type": "string", "format": "uuid" },
          "optionId": { "type": "string", "format": "uuid" },
          "previewId": { "type": "string", "format": "uuid" },
          "projectId": { "type": "string", "format": "uuid" },
          "resultSnapshotSha256": { "$ref": "#/components/schemas/Sha256" },
          "schemaVersion": { "type": "string", "const": "c12-option-confirmation-v1" }
        }
      },
      "Sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "RenderSpecificationReference": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "catalogReleaseId",
          "catalogReleaseSha256",
          "specificationId",
          "specificationRevision",
          "specificationRevisionSha256"
        ],
        "properties": {
          "catalogReleaseId": { "type": "string", "format": "uuid" },
          "catalogReleaseSha256": { "$ref": "#/components/schemas/Sha256" },
          "specificationId": { "type": "string", "format": "uuid" },
          "specificationRevision": { "type": "integer", "minimum": 1 },
          "specificationRevisionSha256": { "$ref": "#/components/schemas/Sha256" }
        }
      },
      "RenderSourceReference": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectId",
          "sceneArtifactId",
          "sceneGlbSha256",
          "sceneId",
          "sceneJobId",
          "sceneManifestSha256",
          "sourceSnapshotSha256"
        ],
        "properties": {
          "projectId": { "type": "string", "format": "uuid" },
          "sceneArtifactId": { "type": "string", "format": "uuid" },
          "sceneGlbSha256": { "$ref": "#/components/schemas/Sha256" },
          "sceneId": { "type": "string", "format": "uuid" },
          "sceneJobId": { "type": "string", "format": "uuid" },
          "sceneManifestSha256": { "$ref": "#/components/schemas/Sha256" },
          "sourceSnapshotSha256": { "$ref": "#/components/schemas/Sha256" },
          "specification": { "$ref": "#/components/schemas/RenderSpecificationReference" }
        }
      },
      "RenderEligibleCamera": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cameraId", "label"],
        "properties": {
          "cameraId": { "type": "string", "format": "uuid" },
          "label": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      },
      "RenderEligibleSource": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cameras", "label", "source"],
        "properties": {
          "cameras": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": { "$ref": "#/components/schemas/RenderEligibleCamera" }
          },
          "label": { "type": "string", "minLength": 1, "maxLength": 160 },
          "source": { "$ref": "#/components/schemas/RenderSourceReference" }
        }
      },
      "RenderEligibleSourcesResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projectId", "schemaVersion", "sources"],
        "properties": {
          "projectId": { "type": "string", "format": "uuid" },
          "schemaVersion": { "type": "string", "const": "c14-render-eligible-sources-v1" },
          "sources": {
            "type": "array",
            "maxItems": 100,
            "items": { "$ref": "#/components/schemas/RenderEligibleSource" }
          }
        }
      }
    }
  }
}
